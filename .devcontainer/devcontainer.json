{
  "name": "Python & Playwright Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/playwright:1": {
      "installChromium": true,
      "installFirefox": true,
      "installWebkit": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-playwright.playwright"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && playwright install-deps"
}