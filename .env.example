# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=f1ndr
# Fail startup if Mongo is unreachable (defaults to true only when ENVIRONMENT=production)
# MONGODB_REQUIRED=true

# JWT / Security
# ENVIRONMENT=production refuses to start unless this is 32+ chars and not a placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
# Comma-separated; these accounts become admins once they verify their email
ADMIN_EMAILS=
# Auth tuning (defaults shown)
# TOKEN_EXPIRY_MINUTES=60
# REFRESH_TOKEN_EXPIRY_DAYS=7
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
# MAX_SESSIONS_PER_USER=5

# Email (verification links). Without SMTP_HOST, links are logged in dev and not sent in production.
EMAIL_FROM=f1ndr <notifications@f1ndr.ca>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=notifications@f1ndr.ca
SMTP_PASSWORD=changeme
SMTP_STARTTLS=true
SMTP_SSL=false
# Frontend page that handles ?token=...; defaults to the API's GET /auth/verify-email
# EMAIL_VERIFICATION_URL=https://f1ndr.ca/verify-email

# App Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# Server (run_backend.py). The Docker image sets HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8000
WORKERS=1
RELOAD=false

# docker-compose only
MONGO_ROOT_USERNAME=changeme
MONGO_ROOT_PASSWORD=changeme
# API_PORT=8000
# MONGO_SCRAPER_ROOT_USERNAME / MONGO_SCRAPER_ROOT_PASSWORD default to the values above

# Optional
REDIS_URI=redis://localhost:6379
API_KEY=changeme
